# Normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly handle JS/JSX/JSON
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf

# Binary files — no conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
