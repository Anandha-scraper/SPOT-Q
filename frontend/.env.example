# Copy to .env.local if you ever need to override this for local dev. For an actual deployment,
# do NOT create a real .env/.env.production from this file — see the note below.

# Leave this unset. It's a Vite build-time substitution, not runtime config: setting it bakes an
# absolute host into the built bundle, which moves every API call cross-origin (CORS + a
# preflight on every request) and breaks the cookie-based login. Unset means relative URLs,
# which the dev proxy (vite.config.js) and nginx (in production) both route to the API for you.
VITE_API_BASE=
