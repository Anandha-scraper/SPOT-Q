# Copy to .env and fill in real values. Never commit the filled-in file — .env* is gitignored.

# --- Required — server.js exits at boot if any of these are missing ---

PORT=5000

# Classic ADO connection string, NOT a URL. A `;` or `=` inside the password breaks parsing.
# TrustServerCertificate=true only for the local VM's self-signed cert; the real company
# SQL Server (192.168.7.56) needs a proper cert and TrustServerCertificate=false.
DATABASE_URL="Server=127.0.0.1,1433;Database=spotq;User Id=CHANGE_ME;Password=CHANGE_ME;Encrypt=true;TrustServerCertificate=true"
JWT_SECRET=CHANGE_ME_use_a_long_random_string
JWT_EXPIRE=1d

# --- Also effectively required, checked separately at boot (assertCookieConfig) ---

# Keyed to transport, not NODE_ENV. false on plain-HTTP LAN, true only under HTTPS.
# Wrong value = login silently bounces (cookie never attaches).
COOKIE_SECURE=false
# lax for same-origin (the normal case here). none requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# --- Optional — server.js warns and falls back to a default if unset ---

# Loopback by default even if left unset. Only set HOST=0.0.0.0 to expose the API on the LAN
# directly (e.g. reaching a dev backend from another machine) — nginx should be the only thing
# reaching it in production.
HOST=127.0.0.1

# Non-admin edit window, e.g. 1h, 30min, or a bare number of seconds. Defaults to 1h if unset.
EDIT_TIME=1h

# Required same-origin too — browsers attach Origin to same-origin POST/PUT/DELETE, so a wrong
# value 403s every mutation while GETs keep working. Exact scheme, no trailing slash.
FRONTEND_URL=http://192.168.22.44

# Per-user download-log retention. Must be a positive integer; anything else falls back to 200.
DLOG=200

# --- Optional — misc ---

NODE_ENV=production
# true adds Prisma query logging. Leave unset/false in production.
PRISMA_LOG=false

# --- Only read by `npm run create-admin` (prisma/seed.js) — not needed for the server itself ---

ADMIN_ID=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false
